                {
                  "question": "What services do you offer?",
                  "answer": "We provide a wide range of financial services including investment planning, wealth management, tax advisory, retirement planning, and risk management."
                },
                {
                  "question": "How do I get started?",
                  "answer": "You can reach out through our contact form or phone line to schedule an initial consultation with one of our financial advisors."
                },
                {
                  "question": "Are your services suitable for individuals and businesses?",
                  "answer": "Yes, we offer tailored banking, credit, and advisory solutions designed for both individual clients and growing businesses."
                },
                {
                  "question": "Do you assist with loans and credit planning?",
                  "answer": "Yes, we help evaluate credit eligibility, compare loan structures, and plan repayments smoothly for personal and business needs."
                }
              ],
              "rightItems": [
                {
                  "question": "Is my financial information kept secure?",
                  "answer": "Yes, we follow strict security protocols, encryption standards, and privacy controls to protect your financial data at all times."
                },
                {
                  "question": "Do you offer personalized financial plans?",
                  "answer": "Every financial plan is customized around your income goals, risk appetite, timeline, and long-term milestones."
                },
                {
                  "question": "How often should I review my financial plan?",
                  "answer": "We recommend reviewing your financial plan every six months or whenever there is a major change in your career, income, or business."
                },
                {
                  "question": "Can you help with long-term wealth creation?",
                  "answer": "Yes, our advisors help structure diversified portfolios and disciplined savings strategies aimed at sustainable long-term wealth creation."
                }
              ]
